{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/service.schema.json",
  "title": "Service entry",
  "description": "One vetted, plain-English entry per service. Information only, not legal advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service",
    "category",
    "sources",
    "last_verified",
    "agreements",
    "optional_items",
    "gotchas",
    "recommended_setup",
    "change_log",
    "disclaimer"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "example": {
      "type": "boolean",
      "description": "True only for fictional sample entries. Must never be published as real."
    },
    "service": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["ai-chatbot", "ai-assistant", "ai-image", "ai-other", "app-store-app", "other"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "last_verified": { "$ref": "#/$defs/date" },
    "agreements": {
      "type": "array",
      "description": "What you agree to, in plain words.",
      "items": { "$ref": "#/$defs/agreement" }
    },
    "optional_items": {
      "type": "array",
      "description": "Parts you can refuse.",
      "items": { "$ref": "#/$defs/optionalItem" }
    },
    "gotchas": {
      "type": "array",
      "items": { "$ref": "#/$defs/gotcha" }
    },
    "recommended_setup": {
      "type": "array",
      "description": "Privacy-first setup, as ordered steps.",
      "items": { "type": "string", "minLength": 1 }
    },
    "change_log": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeLogEntry" }
    },
    "disclaimer": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "url", "retrieved", "content_hash", "hash_algorithm"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "type": {
          "type": "string",
          "enum": ["terms", "privacy-policy", "settings-help", "other"]
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "retrieved": {
          "$ref": "#/$defs/date",
          "description": "Date the page text was captured."
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 (lowercase hex) of the normalized page text as captured."
        },
        "hash_algorithm": { "type": "string", "enum": ["sha256"] },
        "normalization": {
          "type": "string",
          "description": "Version tag of the text-normalization recipe used before hashing."
        }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source_refs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "optionalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "how_to_refuse"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "how_to_refuse": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "sourceRef": {
      "type": "object",
      "description": "Trace from a finding back to the captured text it came from.",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "Section heading or paragraph number in the captured text."
        },
        "excerpt": {
          "type": "string",
          "maxLength": 200,
          "description": "Short quote only (max 200 characters). Never full terms."
        }
      }
    },
    "gotcha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "risk_category",
        "title",
        "severity",
        "default_state",
        "explanation",
        "fix_steps",
        "source_refs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "risk_category": {
          "type": "string",
          "enum": [
            "retention",
            "data_sharing_sale",
            "training_on_data",
            "arbitration_class_waiver",
            "unilateral_changes",
            "auto_renewal",
            "content_license",
            "location_contacts_access",
            "account_deletion"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["high", "medium", "low", "info"] },
        "default_state": {
          "type": "string",
          "enum": ["on", "off", "unavoidable", "not_stated"],
          "description": "What happens if the reader does nothing."
        },
        "explanation": { "type": "string", "minLength": 1 },
        "fix_steps": {
          "type": "array",
          "description": "Ordered steps to change it. May be empty only when default_state is unavoidable or not_stated.",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "changeLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "summary"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "summary": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string" },
        "old_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "new_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

{
  "manifest_version": 3,
  "name": "Term Sherpa",
  "version": "1.0.0",
  "description": "Explains the terms, privacy policy or 'I agree' dialog you are on in plain English, on this device. Nothing saved by default.",
  "action": {
    "default_title": "Term Sherpa: explain this page",
    "default_popup": "explain/launcher.html"
  },
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
